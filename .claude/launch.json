{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "hc-hr (composer dev)",
      "runtimeExecutable": "composer",
      "runtimeArgs": ["dev"],
      "port": 8000,
      "autoPort": false
    },
    {
      "name": "hc-hr (artisan serve)",
      "runtimeExecutable": "php",
      "runtimeArgs": ["artisan", "serve", "--port=8299"],
      "port": 8299,
      "autoPort": false
    },
    {
      "name": "hc-hr (php 8.5 serve)",
      "runtimeExecutable": "C:/laragon/bin/php/php-8.5/php.exe",
      "runtimeArgs": ["artisan", "serve", "--port=8385"],
      "port": 8385,
      "autoPort": false
    }
  ]
}

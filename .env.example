APP_NAME=HopeHR
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://hope-hr.test
LOCAL_SEED_PASSWORD=

# Browser security headers. HSTS defaults on in staging/production and off
# locally. Keep CSP report-only until violations have been reviewed.
SECURITY_HEADERS_HSTS=false
CSP_REPORT_ONLY=true

APP_LOCALE=ar
APP_FALLBACK_LOCALE=ar
APP_FAKER_LOCALE=ar_AE

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hr_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
OFFICE_PREVIEW_CONVERSION_ENABLED=false

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Never commit real credentials here. This file is tracked in Git; put actual
# values only in .env (untracked) or the deployment secret manager.
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

GOOGLE_DRIVE_API_KEY=

# Contract PDF export (Spatie Browsershot). Leave unset to use the defaults
# in config/browsershot.php (system Chrome on Windows, Node on PATH).
BROWSERSHOT_CHROME_PATH=
BROWSERSHOT_NODE_BINARY=
# Directory Node resolves `puppeteer` from. Needed on hosts with no global npm,
# where Browsershot's `npm root -g` lookup comes back empty; point it at the
# project's own node_modules, e.g. /home/user/hr/node_modules
BROWSERSHOT_NODE_MODULE_PATH=
BROWSERSHOT_TIMEOUT=120
# Last resort for hosts that cap the number of processes an account may
# spawn; modern Chrome handles --single-process poorly, so leave it off unless
# the default launch is demonstrably being killed by that cap.
BROWSERSHOT_SINGLE_PROCESS=false
# Parent directory the web user owns, for the per-render Chrome profile.
# Defaults to the system temp directory.
BROWSERSHOT_USER_DATA_DIR=
# Short (<60 chars) writable directory for Chrome's process-singleton socket.
# Defaults to the system temp directory; a long path aborts the launch with
# "Socket path too long".
BROWSERSHOT_TMP_DIR=
# Comma-separated extra chromium flags, no leading --
BROWSERSHOT_CHROMIUM_ARGS=

<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # User uploads are served from /storage (a symlink to storage/app/public).
    # Nothing under that path may ever reach an interpreter. The upload
    # pipeline already re-encodes images and assigns server-controlled names;
    # this is the independent web-server layer that holds even if that
    # pipeline is bypassed. Matched before the front controller so it applies
    # whether or not the requested file exists.
    RewriteRule ^storage/.*\.(php[0-9]?|phtml|phps|phar|pht|cgi|pl|py|rb|sh|asp|aspx|jsp|htaccess|htpasswd)$ - [F,L,NC]
    # Double extensions such as logo.php.jpg: some AddHandler configurations
    # dispatch these to mod_php on the basis of the inner extension.
    RewriteRule ^storage/.*\.(php[0-9]?|phtml|phar|pht)\. - [F,L,NC]

    # Enforce TLS for non-local hosts. If TLS terminates at a reverse proxy,
    # configure Apache's HTTPS environment flag at the trusted proxy boundary.
    # Do not trust a client-supplied X-Forwarded-Proto header here.
    RewriteCond %{HTTP_HOST} !^(localhost|127\.0\.0\.1)(:\d+)?$ [NC]
    RewriteCond %{HTTPS} !=on
    RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=308,L]

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Handle X-XSRF-Token Header
    RewriteCond %{HTTP:x-xsrf-token} .
    RewriteRule .* - [E=HTTP_X_XSRF_TOKEN:%{HTTP:X-XSRF-Token}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Compress text responses at the origin. Brotli is preferred when available;
# mod_deflate remains the fallback for Apache installations without Brotli.
<IfModule mod_brotli.c>
    AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# Vite content-hashed assets are safe to cache permanently. Application HTML
# and authenticated responses retain Laravel's private/no-store semantics.
<IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/build/assets/.+-[A-Za-z0-9_-]{8,}\.(css|js|woff2?|png|jpe?g|gif|svg|webp|avif)$" vite_hashed_asset
</IfModule>

<IfModule mod_headers.c>
    Header always unset X-Powered-By
    Header set Cache-Control "public, max-age=31536000, immutable" env=vite_hashed_asset
</IfModule>
